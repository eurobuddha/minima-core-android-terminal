<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- allowBackup=false: the whole apks/ fleet was scaffolded with allowBackup="true" and empty backup
         rules, so Android Auto Backup uploaded each app's entire data directory to the user's cloud and
         restored it on reinstall. Harmless-looking apps still carried the node pairing token, and a
         reinstall must be a true reset everywhere, not just in the apps holding keys.
         At stake here: minimaevents.db, the node event log, plus the shared minima_api_prefs pairing token. No command history
         is stored here (unlike Terminal IDE), but none of it should be restored onto a different node -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/terminal"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Terminal"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".receiver.MinimaNotifyReceiver" android:exported="true">
            <intent-filter>
                <action android:name="org.minimarex.minimacore.NOTIFY" />
            </intent-filter>
        </receiver>

    </application>

</manifest>